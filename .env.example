# Copy to .env (`cp .env.example .env`). No real credentials: these match docker-compose.yml.
DATABASE_URL=postgres://checkout:checkout@localhost:54329/checkout
BIND_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=20

# Every REWARD_EVERY_N_ORDERS-th successful order makes one coupon of
# REWARD_DISCOUNT_PERCENT % available for an administrator to generate.
REWARD_EVERY_N_ORDERS=5
REWARD_DISCOUNT_PERCENT=10

RUST_LOG=info,checkout_service=debug,sqlx=warn
